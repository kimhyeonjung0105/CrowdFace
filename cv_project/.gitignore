# 다른 PC에서 받는 방법: CLAUDE.md 8절, 점검: python src/check_setup.py
.venv/
__pycache__/
# 참조 저장소 (git clone으로 받음)
refs/
# 가중치 (용량 큼, 팀 드라이브로 공유)
models/*.pt
# CrowdHuman 사진·라벨 (재배포 금지)
data/*
!data/.keep
results/*.jpg
# 예시 사진 결과 (make_report.py가 다시 만듦)
results/report/ex_*.jpg
# CrowdHuman 사진 이름이 들어 있어 뺌
results/eval/per_image.csv
# 학습 기록은 곡선용 숫자(results.csv)와 설정(args.yaml)만 올림
runs/**
!runs/
!runs/head/
!runs/head/*/
!runs/head/*/results.csv
!runs/head/*/args.yaml
